.page {
  padding: 24rpx 24rpx 60rpx;
  position: relative;
  min-height: 100vh;
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.65;
}

.timer {
  min-width: 96rpx;
  text-align: center;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(0,0,0,0.35);
  font-size: 34rpx;
  font-weight: 700;
}

.timer.urgent {
  background: #d4522a;
  color: #fff;
  animation: pulse 0.8s ease-in-out infinite;
}

@keyframes pulse {
  50% { transform: scale(1.06); }
}

.turn {
  margin: 8rpx 0 16rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.aid-tag {
  margin-left: 12rpx;
  color: #ffcc80;
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.toolbar .btn {
  flex: 1;
  min-width: 160rpx;
}

.props {
  margin-top: 28rpx;
}

.props .label {
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 12rpx;
}

.prop-row {
  display: flex;
  gap: 12rpx;
}

.prop-row .btn {
  flex: 1;
  font-size: 24rpx;
  padding: 16rpx 8rpx;
}

.aid-hint {
  margin-top: 20rpx;
  padding: 16rpx;
  background: rgba(212, 82, 42, 0.2);
  border-radius: 12rpx;
  font-size: 26rpx;
}

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.card {
  width: 70%;
  background: #3d2f22;
  border-radius: 20rpx;
  padding: 48rpx 36rpx;
  text-align: center;
  border: 2rpx solid rgba(243,230,208,0.2);
}

.result {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 36rpx;
}
