.page {
  padding: 48rpx 40rpx 80rpx;
}

.hero {
  padding: 48rpx 0 36rpx;
}

.brand {
  font-size: 88rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: #f3e6d0;
  text-shadow: 0 8rpx 24rpx rgba(0,0,0,0.45);
}

.tagline {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.72;
}

.section {
  margin-top: 36rpx;
}

.label {
  font-size: 26rpx;
  opacity: 0.7;
  margin-bottom: 16rpx;
}

.input {
  background: rgba(0,0,0,0.28);
  border: 2rpx solid rgba(243,230,208,0.18);
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  color: #f3e6d0;
  font-size: 28rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(243,230,208,0.22);
  font-size: 26rpx;
  opacity: 0.85;
}

.chip.on {
  background: #d4522a;
  border-color: #d4522a;
  color: #fff;
  opacity: 1;
}

.skins {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.skin {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  font-size: 22rpx;
  opacity: 0.8;
}

.skin.on {
  border-color: #d4522a;
  opacity: 1;
  background: rgba(212,82,42,0.12);
}

.actions {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.join-row {
  display: flex;
  gap: 16rpx;
}

.join-row .code {
  flex: 1;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.hint {
  margin-top: 24rpx;
  color: #ff8a65;
  font-size: 24rpx;
}
