<view class="page">
  <view class="hero">
    <view class="brand">棋霸</view>
    <view class="tagline">真联机 · 多棋种 · 道具与外援</view>
  </view>

  <view class="section">
    <view class="label">昵称</view>
    <input class="input" value="{{name}}" bindinput="onName" maxlength="12" placeholder="输入昵称" />
  </view>

  <view class="section">
    <view class="label">下棋类型</view>
    <view class="chips">
      <view
        wx:for="{{gameTypes}}"
        wx:key="id"
        class="chip {{gameType===item.id?'on':''}}"
        data-id="{{item.id}}"
        bindtap="pickGame"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="section">
    <view class="label">对弈模式</view>
    <view class="chips">
      <view
        wx:for="{{modes}}"
        wx:key="id"
        class="chip {{mode===item.id?'on':''}}"
        data-id="{{item.id}}"
        bindtap="pickMode"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="section">
    <view class="label">煤球装扮</view>
    <view class="skins">
      <view
        wx:for="{{skins}}"
        wx:key="id"
        class="skin {{skin===item.id?'on':''}}"
        data-id="{{item.id}}"
        bindtap="pickSkin"
      >
        <coal-piece skin="{{item.id}}" color="{{1}}" size="56" />
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="label">服务器</view>
    <input class="input" value="{{wsUrl}}" bindinput="onWs" placeholder="ws://127.0.0.1:3000" />
  </view>

  <view class="actions">
    <view class="btn" bindtap="createRoom">创建房间</view>
    <view class="join-row">
      <input class="input code" value="{{joinCode}}" bindinput="onCode" maxlength="6" placeholder="房间码" />
      <view class="btn" bindtap="joinRoom">加入</view>
    </view>
    <view class="btn ghost" bindtap="joinWatch">观战加入（外援）</view>
  </view>

  <view class="hint" wx:if="{{err}}">{{err}}</view>
</view>
