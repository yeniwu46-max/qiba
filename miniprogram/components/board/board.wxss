.board-wrap {
  width: 100%;
  padding: 16rpx;
  box-sizing: border-box;
}

.board {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background:
    linear-gradient(135deg, rgba(255,255,255,0.08), transparent 40%),
    radial-gradient(circle at 30% 20%, #d8b887, #a67c4a 55%, #7a5528);
  border-radius: 16rpx;
  box-shadow: inset 0 0 0 4rpx rgba(60, 40, 20, 0.35), 0 12rpx 28rpx rgba(0,0,0,0.35);
  overflow: hidden;
}

.grid-lines {
  position: absolute;
  top: 3%;
  right: 3%;
  bottom: 3%;
  left: 3%;
  background-image:
    linear-gradient(rgba(60, 35, 10, 0.35) 1px, transparent 1px),
    linear-gradient(90deg, rgba(60, 35, 10, 0.35) 1px, transparent 1px);
  background-size: calc(100% / var(--n)) calc(100% / var(--n));
  pointer-events: none;
}

.cell {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.cell.hl {
  background: rgba(212, 82, 42, 0.25);
}
